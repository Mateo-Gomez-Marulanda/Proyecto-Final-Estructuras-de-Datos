<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="proyectofinal.controllers.AgendarVisitaCLIController"
      prefWidth="450"
      style="-fx-background-color: #f8fafc;">

    <VBox spacing="4" style="-fx-background-color: #1e293b; -fx-padding: 20 24 20 24;">
        <Label text="Solicitar Visita" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </VBox>

    <VBox spacing="20" style="-fx-padding: 24;">
        <VBox spacing="4">
            <Label text="Inmueble" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
            <TextField fx:id="txtInmueble" editable="false" style="-fx-background-color: #e2e8f0;"/>
        </VBox>

        <GridPane hgap="16" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Fecha *" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Hora *" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbHora" maxWidth="Infinity" promptText="Seleccione hora"/>
            </VBox>
        </GridPane>

        <VBox spacing="4">
            <Label text="Observaciones" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="txtObservaciones" prefRowCount="3"/>
        </VBox>

        <Label fx:id="labelMensaje" visible="false" wrapText="true" style="-fx-font-weight: bold;"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-background-color: #f1f5f9; -fx-padding: 16 24;">
        <Button text="Cancelar" onAction="#cancelarAgendamiento"/>
        <Button text="✔ Confirmar" onAction="#guardarVisita" style="-fx-background-color: #1e293b; -fx-text-fill: white;"/>
    </HBox>
</VBox>