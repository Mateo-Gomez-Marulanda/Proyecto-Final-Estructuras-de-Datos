<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="proyectofinal.controllers.ClientCatalogController"
      spacing="16" styleClass="content-area">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Explorar inmuebles" styleClass="modulo-titulo"/>
        <Label text="Encuentra la propiedad ideal para ti" styleClass="modulo-subtitulo"/>
    </VBox>

    <!-- Filtros -->
    <HBox styleClass="barra-filtros" spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="campoBusqueda"
                   styleClass="campo-busqueda"
                   promptText="Buscar por ciudad, zona o dirección..."
                   onKeyReleased="#filtrar"/>
        <ComboBox fx:id="filtroTipo"
                  styleClass="combo-filtro"
                  promptText="Tipo"
                  onAction="#filtrar"/>
        <ComboBox fx:id="filtroFinalidad"
                  styleClass="combo-filtro"
                  promptText="Finalidad"
                  onAction="#filtrar"/>
        <ComboBox fx:id="filtroPrecio"
                  styleClass="combo-filtro"
                  promptText="Rango de precio"
                  onAction="#filtrar"/>
        <Button text="Limpiar" styleClass="boton-secundario" onAction="#limpiarFiltros"/>
    </HBox>

    <!-- Tabla de propiedades -->
    <TableView fx:id="tablaInmuebles"
               styleClass="tabla-principal"
               VBox.vgrow="ALWAYS">
        <placeholder><Label text="No hay inmuebles disponibles con esos criterios."/></placeholder>
        <columns>
            <TableColumn fx:id="colCodigo"     text="Código"      prefWidth="90"/>
            <TableColumn fx:id="colDireccion"  text="Dirección"   prefWidth="190"/>
            <TableColumn fx:id="colCiudad"     text="Ciudad"      prefWidth="100"/>
            <TableColumn fx:id="colZona"       text="Zona"        prefWidth="100"/>
            <TableColumn fx:id="colTipo"       text="Tipo"        prefWidth="120"/>
            <TableColumn fx:id="colFinalidad"  text="Finalidad"   prefWidth="90"/>
            <TableColumn fx:id="colPrecio"     text="Precio"      prefWidth="120"/>
            <TableColumn fx:id="colHab"        text="Hab."        prefWidth="55"/>
            <TableColumn fx:id="colArea"       text="Área m²"     prefWidth="80"/>
            <TableColumn fx:id="colAsesor"     text="Asesor"      prefWidth="130"/>
        </columns>
    </TableView>

    <!-- Barra de acciones -->
    <HBox styleClass="barra-acciones" spacing="10" alignment="CENTER_LEFT">
        <Button text="⭐  Guardar en favoritos"
                fx:id="btnFavorito"
                styleClass="boton-advertencia"
                onAction="#guardarFavorito"
                disable="true"/>
        <Button text="📅  Agendar visita"
                fx:id="btnAgendar"
                styleClass="boton-primario"
                onAction="#agendarVisita"
                disable="true"/>
        <Button text="📄  Ver detalles"
                fx:id="btnDetalles"
                styleClass="boton-secundario"
                onAction="#verDetalles"
                disable="true"/>
    </HBox>

</VBox>
