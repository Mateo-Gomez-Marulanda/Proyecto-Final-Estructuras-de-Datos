<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="content-area" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyectofinal.controllers.OperacionesController">

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="modulo-titulo" text="Operaciones de negocio" />
            <Label styleClass="modulo-subtitulo" text="Registro de arriendos, ventas y contratos" />
        </VBox>
    </HBox>

    <!-- Tarjetas de resumen por tipo -->
    <HBox spacing="12">
        <VBox prefWidth="160" spacing="4" styleClass="stat-card">
            <Label styleClass="stat-icono-azul" text="🤝" />
            <Label fx:id="numArriendos" styleClass="stat-numero" text="0" />
            <Label styleClass="stat-label" text="Arriendos" />
        </VBox>
        <VBox prefWidth="160" spacing="4" styleClass="stat-card">
            <Label styleClass="stat-icono-verde" text="🏠" />
            <Label fx:id="numVentas" styleClass="stat-numero" text="0" />
            <Label styleClass="stat-label" text="Ventas" />
        </VBox>
        <VBox prefWidth="160" spacing="4" styleClass="stat-card">
            <Label styleClass="stat-icono-ambar" text="🔄" />
            <Label fx:id="numRenovaciones" styleClass="stat-numero" text="0" />
            <Label styleClass="stat-label" text="Renovaciones" />
        </VBox>
        <VBox prefWidth="160" spacing="4" styleClass="stat-card">
            <Label styleClass="stat-icono-rojo" text="❌" />
            <Label fx:id="numCancelaciones" styleClass="stat-numero" text="0" />
            <Label styleClass="stat-label" text="Cancelaciones" />
        </VBox>
    </HBox>

    <!-- Barra de búsqueda y filtros -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barra-filtros">
        <TextField fx:id="campoBusqueda" onKeyReleased="#filtrarTabla" promptText="Buscar por ID, cliente o inmueble..." styleClass="campo-busqueda" />
        <ComboBox fx:id="filtroTipoOperacion" onAction="#filtrarTabla" promptText="Tipo de operación" styleClass="combo-filtro" />
        <ComboBox fx:id="filtroEstado" onAction="#filtrarTabla" promptText="Estado" styleClass="combo-filtro" />
        <Button onAction="#limpiarFiltros" styleClass="boton-secundario" text="Limpiar" />
    </HBox>

    <!-- Tabla de operaciones -->
    <TableView fx:id="tablaOperaciones" styleClass="tabla-principal" VBox.vgrow="ALWAYS">
        <placeholder><Label text="No hay operaciones registradas." /></placeholder>
        <columns>
            <TableColumn fx:id="colId" prefWidth="90" text="ID" />
            <TableColumn fx:id="colTipo" prefWidth="130" text="Tipo" />
            <TableColumn fx:id="colInmueble" prefWidth="130" text="Inmueble" />
            <TableColumn fx:id="colCliente" prefWidth="150" text="Cliente" />
            <TableColumn fx:id="colAsesor" prefWidth="130" text="Asesor" />
            <TableColumn fx:id="colValor" prefWidth="110" text="Valor" />
            <TableColumn fx:id="colComision" prefWidth="100" text="Comisión" />
            <TableColumn fx:id="colFecha" prefWidth="100" text="Fecha" />
            <TableColumn fx:id="colEstadoProceso" prefWidth="110" text="Estado" />
        </columns>
    </TableView>

    <!-- Barra de acciones -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="barra-acciones">
        <Button fx:id="btnVerDetalles" disable="true" onAction="#verDetallesOperacion" styleClass="boton-secundario" text="📄  Ver detalles" />
        <Button fx:id="btnEditarEstado" disable="true" onAction="#editarEstadoOperacion" styleClass="boton-secundario" text="✏️  Editar estado" />
    </HBox>

</VBox>
