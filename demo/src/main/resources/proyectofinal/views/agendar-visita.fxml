<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="proyectofinal.controllers.AgendarVisitaController"
      spacing="0"
      prefWidth="540"
      style="-fx-background-color: #f8fafc;">

    <!-- ── Header ── -->
    <VBox spacing="4"
          style="-fx-background-color: #1e293b; -fx-padding: 20 24 20 24;">
        <Label text="Agendar Visita"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Complete todos los campos obligatorios (*)"
               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
    </VBox>

    <!-- ── Form body ── -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="20" style="-fx-padding: 24;">

            <!-- ── Participantes ── -->
            <VBox spacing="10">
                <Label text="Participantes"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #475569;"/>
                <Separator/>
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- Cliente -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Cliente *"
                               style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="campoCliente"
                                  promptText="Seleccione cliente"
                                  maxWidth="Infinity"
                                  onAction="#onClienteSeleccionado"/>
                    </VBox>

                    <!-- Tipo de cliente (informativo) -->
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Tipo de cliente"
                               style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;"/>
                        <Label fx:id="labelTipoCliente"
                               text="—"
                               style="-fx-font-size: 13px; -fx-text-fill: #64748b;
                                      -fx-padding: 8 0 0 0;"/>
                    </VBox>

                    <!-- Inmueble -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1"
                          GridPane.columnSpan="2">
                        <Label text="Inmueble *"
                               style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="campoInmueble"
                                  promptText="Seleccione inmueble"
                                  maxWidth="Infinity"
                                  onAction="#onInmuebleSeleccionado"/>
                    </VBox>

                    <!-- Asesor asignado (informativo) -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2"
                          GridPane.columnSpan="2">
                        <Label text="Asesor responsable"
                               style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;"/>
                        <Label fx:id="labelAsesor"
                               text="Se asignará según el inmueble seleccionado"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b;
                                      -fx-padding: 4 0 0 0;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- ── Fecha y hora ── -->
            <VBox spacing="10">
                <Label text="Fecha y hora"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #475569;"/>
                <Separator/>
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <!-- Fecha -->
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Fecha *"
                               style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="campoFecha"
                                    promptText="dd/mm/aaaa"
                                    maxWidth="Infinity"/>
                    </VBox>

                    <!-- Hora -->
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Hora *"
                               style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;"/>
                        <Spinner fx:id="campoHora"
                                 min="0" max="23" initialValue="9"
                                 editable="true"/>
                    </VBox>

                    <!-- Minutos -->
                    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Minutos *"
                               style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;"/>
                        <Spinner fx:id="campoMinutos"
                                 min="0" max="59" initialValue="0"
                                 editable="true"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- ── Label de error ── -->
            <Label fx:id="labelError"
                   text=""
                   style="-fx-text-fill: #dc2626; -fx-font-size: 12px;"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

        </VBox>
    </ScrollPane>

    <!-- ── Footer ── -->
    <HBox spacing="12" alignment="CENTER_RIGHT"
          style="-fx-background-color: #f1f5f9; -fx-padding: 16 24 16 24;
                 -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
        <Button text="Cancelar"
                styleClass="boton-secundario"
                onAction="#cancelar"/>
        <Button text="✔  Agendar visita"
                styleClass="boton-primario"
                defaultButton="true"
                onAction="#agendarVisita"/>
    </HBox>

</VBox>
